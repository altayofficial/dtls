{
    "name": "altayofficial/dtls",
    "description": "Pure PHP DTLS 1.2 - no FFI, no native libraries",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "altay\\dtls\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "altay\\dtls\\tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
